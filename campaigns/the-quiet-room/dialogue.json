{
  "campaign_id": "the-quiet-room",
  "content": {
    "dialogues": [
      {
        "nodes": [
          {
            "id": "dlg/keeper",
            "options": [
              {
                "effects": [
                  {
                    "objective": "obj/hear-the-keeper",
                    "type": "complete-objective"
                  }
                ],
                "label": "What does it keep?",
                "next": "dlg/keeper-dead"
              },
              {
                "effects": [
                  {
                    "objective": "obj/the-last-word",
                    "type": "complete-objective"
                  }
                ],
                "label": "Why the bell?",
                "next": "dlg/keeper-bell"
              }
            ],
            "text": "I am the Keeper. This is the Quiet Keep. Soldiers held it once. When they left, I stayed to look after what they left behind."
          },
          {
            "id": "dlg/keeper-dead",
            "options": [
              {
                "effects": [
                  {
                    "objective": "obj/the-last-word",
                    "type": "complete-objective"
                  }
                ],
                "label": "Why the bell?",
                "next": "dlg/keeper-bell"
              }
            ],
            "text": "Its dead. The soldiers who died here lie under the floor of the side room, and the bell wakes them. You rang it, and you put them back down."
          },
          {
            "id": "dlg/keeper-bell",
            "text": "I hung it over them myself, so that someone would come and lay them to rest. Nobody had rung it in years, until you."
          }
        ],
        "npc": "npc/keeper",
        "root": "dlg/keeper"
      }
    ]
  },
  "dsl_version": "0.36.0",
  "stage": "dialogue"
}

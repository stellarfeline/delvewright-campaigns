{
  "campaign_id": "the-quiet-room",
  "content": {
    "guidance": {
      "announcements": "hidden",
      "markers": "hidden"
    },
    "quests": [
      {
        "cast": {
          "npc/keeper": {
            "at": "anchor/boss",
            "dialogue": "dlg/keeper",
            "doing": "standing alone in the great hall, listening for the gate and the bell"
          }
        },
        "happening": {
          "text": "The party enters a keep that explains nothing and answers everything they do.",
          "verb": "learns"
        },
        "id": "quest/the-room",
        "objectives": [
          {
            "anchor": "anchor/keeper-stand",
            "happening": {
              "subject": "anchor/gate",
              "text": "They pull the lever at the warden's empty stand, and the gate beside it lifts.",
              "verb": "opens"
            },
            "id": "obj/the-gate-lever",
            "prop": {
              "block": "minecraft:lever[face=floor,facing=north]"
            },
            "type": "interact"
          },
          {
            "after": [
              "obj/the-gate-lever"
            ],
            "anchor": "anchor/wave",
            "announcement": "shown",
            "happening": {
              "subject": "wave/watch",
              "text": "They ring the bell in the side room, and the watch comes up around it.",
              "verb": "arrives"
            },
            "hint": "Past the gate, a bell stands in the side room. Ringing it wakes what the floor is keeping.",
            "id": "obj/the-bell",
            "prop": {
              "block": "minecraft:bell[attachment=floor,facing=north]"
            },
            "title": "Ring the bell in the side room",
            "type": "interact"
          },
          {
            "after": [
              "obj/the-bell"
            ],
            "happening": {
              "subject": "wave/watch",
              "text": "The watch they woke is put down where it woke.",
              "verb": "dies"
            },
            "id": "obj/the-watch",
            "type": "kill",
            "wave": "wave/watch"
          },
          {
            "after": [
              "obj/the-watch"
            ],
            "happening": {
              "subject": "npc/keeper",
              "text": "The Keeper says the first thing: what the keep was keeping.",
              "verb": "learns"
            },
            "id": "obj/hear-the-keeper",
            "npc": "npc/keeper",
            "type": "talk-to"
          },
          {
            "after": [
              "obj/hear-the-keeper"
            ],
            "happening": {
              "subject": "npc/keeper",
              "text": "The Keeper says the second thing, which he says to nobody who did not hear the first.",
              "verb": "learns"
            },
            "id": "obj/the-last-word",
            "npc": "npc/keeper",
            "type": "talk-to"
          }
        ],
        "on_complete": [
          {
            "ending": "The keep answered what they did, and nothing else.",
            "happening": {
              "text": "The party leaves a keep that told them nothing and showed them everything.",
              "verb": "survives"
            },
            "type": "campaign-complete"
          }
        ],
        "on_objective_complete": {
          "obj/the-bell": [
            {
              "happening": {
                "subject": "wave/watch",
                "text": "The watch comes up out of the floor around the bell.",
                "verb": "arrives"
              },
              "type": "spawn-wave",
              "wave": "wave/watch"
            },
            {
              "style": "chat",
              "text": "The bell rings once, and the floor gives up what it was keeping.",
              "type": "narrate"
            }
          ],
          "obj/the-gate-lever": [
            {
              "anchor": "anchor/gate",
              "happening": {
                "subject": "anchor/gate",
                "text": "The gate beside the stand lifts.",
                "verb": "opens"
              },
              "type": "open-gate"
            }
          ],
          "obj/the-last-word": [
            {
              "style": "chat",
              "text": "The Keeper turns back to his hall. That was all of it.",
              "type": "narrate"
            }
          ],
          "obj/the-watch": [
            {
              "style": "chat",
              "text": "The last of the watch goes still. The side room is quiet again.",
              "type": "narrate"
            }
          ]
        },
        "trigger": {
          "type": "campaign-start"
        }
      }
    ],
    "triggers": [
      {
        "at": "anchor/exit",

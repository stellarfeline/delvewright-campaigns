          {
            "style": "chat",
            "text": "The gatehouse is cold and dry. You would come back here, if it came to that.",
            "type": "narrate"
          }
        ],
        "id": "trigger/the-gatehouse",
        "on": {
          "on": "approach",
          "range": 3
        }
      }
    ],
    "waves": [
      {
        "anchor": "anchor/wave",
        "id": "wave/watch",
        "mobs": [
          {

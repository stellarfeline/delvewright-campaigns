                  ]
                },
                {
                  "at_ticks": 250,
                  "effects": [
                    {
                      "type": "campaign-complete",
                      "ending": "ending/the-tide",
                      "happening": {
                        "verb": "loses",
                        "text": "The field gives Wren Ashlaw up to the water and keeps nothing of her."
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        "on_complete": []
      }
    ]
  }

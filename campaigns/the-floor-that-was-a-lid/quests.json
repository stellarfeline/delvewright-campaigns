{
  "campaign_id": "the-floor-that-was-a-lid",
  "content": {
    "lethal_volumes": [
      {
        "damage_type": "fall",
        "id": "lethal/the-pit",
        "message": "The floor was a lid, and the pit under it has no bottom you would survive.",
        "region": {
          "anchor": "anchor/pit",
          "extent": [
            1,
            0,
            1
          ]
        },
        "when": {
          "requires_flags": [
            "flag/lid-fell"
          ]
        }
      }
    ],
    "on_death": [
      {
        "style": "actionbar",
        "text": "The pit keeps what falls into it. You wake where you came in.",
        "type": "narrate"
      }

  "after_action": "close",
  "body": [
    {
      "contents": "站住——别紧张，别紧张，我是值守的，不是麻烦。赫德里克。你就是玛伦请来的那位吧。我真想亲自送你下去，真的，可这条膝盖不答应。跑了二十年的地穴，最后是什么把我撂倒的？不是飞龙，也不是冢中妖物——一支弩箭，正正穿过膝盖。我的冒险生涯就到那儿了。",
      "type": "minecraft:plain_message"
    }
  ],
  "can_close_with_escape": true,
  "columns": 1,
  "title": "值守人赫德里克",
  "type": "minecraft:multi_action"
}

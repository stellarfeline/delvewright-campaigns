{
  "campaign_id": "the-treehouse-camp",
  "content": {
    "guidance": {
      "announcements": "shown",
      "markers": "hidden"
    },
    "quests": [
      {
        "cast": {
          "npc/hessel": {
            "at": "anchor/node-seed-house",
            "dialogue": {
              "barks": [
                "In my grandfather's day, guests brought gifts. You brought good boots. That will do.",
                "The press is slow, and so am I. We get there."
              ]
            },
            "doing": "at the nut press, filling flasks with this year's oil"
          },
          "npc/neve": {
            "at": "anchor/node-loom-house",
            "dialogue": {
              "barks": [
                "The shade is nearly dry. Oru will send someone for it.",
                "Mind the cloth lines. That red is three days of dyeing."
              ]
            },
            "doing": "at her looms, finishing the new lantern's shade"
          },
          "npc/oru": {
            "at": "anchor/node-hearth-house",
            "dialogue": "dlg/oru-ask",
            "doing": "by the hearth in the Hearth House, waiting for the guests Tobi was sent to fetch"
          },
          "npc/tobi": {
            "at": "anchor/node-root-glade",
            "dialogue": "dlg/tobi-root",
            "doing": "waiting at the foot of the rope ladder for the guests, and not climbing it"
          }
        },
        "happening": {
          "subject": "npc/tobi",
          "text": "The guests arrive among the Hearth Tree's roots on Lantern Night.",
          "verb": "arrives"
        },
        "id": "quest/the-ask",
        "objectives": [
          {
            "happening": {
              "subject": "npc/tobi",
              "text": "Tobi tells the guests Oru is waiting in the Hearth House, and that the ladder frightens him.",
              "verb": "learns"
            },
            "hint": "He waits at the foot of the rope ladder on the great trunk.",
            "id": "obj/meet-tobi",
            "npc": "npc/tobi",
            "title": "Speak to Tobi",
            "type": "talk-to"
          },
          {
            "after": [
              "obj/meet-tobi"
            ],
            "happening": {
              "subject": "npc/oru",
              "text": "Oru explains Lantern Night and asks the guests to carry the lantern up for her.",
              "verb": "learns"
            },
            "hint": "Climb the rope ladder on the Hearth Tree's trunk to the platform above.",
            "id": "obj/hear-oru",
            "npc": "npc/oru",
            "title": "Climb up to Oru",
            "type": "talk-to"
          }
        ],
        "on_complete": [],
        "trigger": {
          "type": "campaign-start"
        }
      },
      {
        "cast": {
          "npc/hessel": {
            "at": "anchor/node-seed-house",
            "dialogue": "dlg/hessel-oil",
            "doing": "at the nut press, a flask of oil set aside"
          },
          "npc/neve": {
            "at": "anchor/node-loom-house",
            "dialogue": "dlg/neve-lantern",
            "doing": "at her looms, with the new lantern ready on the bench"
          },
          "npc/oru": {
            "at": "anchor/node-hearth-house",
            "dialogue": "dlg/oru-waiting",
            "doing": "by the hearth, keeping the fire up for the lighting"
          },
          "npc/tobi": {
            "at": "anchor/node-root-glade",
            "dialogue": {
              "barks": [
                "Did you look down? I always look down. I shouldn't.",
                "Oru says the ladder gets easier. It hasn't yet."
              ]
            },
            "doing": "still at the foot of the ladder, looking up"
          }
        },
        "happening": {
          "subject": "npc/oru",
          "text": "The guests go for the lantern and the oil, one across each bridge.",
          "verb": "learns"
        },
        "id": "quest/lantern-and-oil",
        "objectives": [
          {
            "happening": {
              "subject": "item/night-lantern",
              "text": "Neve hands over the Night Lantern in this year's shade.",
              "verb": "gains"
            },
            "hint": "Cross the Long Bridge from the Hearth House to the Loom House.",
            "id": "obj/fetch-the-lantern",
            "npc": "npc/neve",
            "title": "Fetch the lantern from Neve",
            "type": "talk-to"
          },
          {
            "happening": {
              "subject": "item/lamp-oil",
              "text": "Hessel hands over a flask of this year's lamp oil.",
              "verb": "gains"
            },
            "hint": "Cross the Low Bridge from the Hearth House to the Seed House.",
            "id": "obj/fetch-the-oil",
            "npc": "npc/hessel",
            "title": "Fetch lamp oil from Hessel",
            "type": "talk-to"
          }
        ],
        "on_complete": [],
        "on_objective_complete": {
          "obj/fetch-the-lantern": [
            {
              "count": 1,
              "item": "minecraft:lantern",
              "name": "Night Lantern",
              "type": "give-item"
            }
          ],
          "obj/fetch-the-oil": [
            {
              "count": 1,
              "item": "minecraft:honey_bottle",
              "name": "Flask of Lamp Oil",
              "type": "give-item"
            }
          ]
        },
        "trigger": {
          "quest": "quest/the-ask",
          "type": "quest-complete"
        }
      },
      {
        "cast": {
          "npc/hessel": {
            "at": "anchor/node-seed-house",
            "dialogue": {
              "barks": [
                "That flask is full to the top. I checked twice.",
                "Mind the third plank from the Hearth end. It is soft. Neve says it is the rope."
              ]
            },
            "doing": "wiping down the press for the night"
          },
          "npc/neve": {
            "at": "anchor/node-loom-house",
            "dialogue": {
              "barks": [
                "Go on. Oru lights it, not me.",
                "Carry it upright. The shade scorches if it tips."
              ]
            },
            "doing": "at her looms, with one eye on the Hearth House"
          },
          "npc/oru": {
            "at": "anchor/node-hearth-house",
            "dialogue": "dlg/oru-light",
            "doing": "at the hearth with a taper ready"
          },
          "npc/tobi": {
            "at": "anchor/node-root-glade",
            "dialogue": {
              "barks": [
                "Is it lit yet? I can't see from down here.",
                "When it's lit, Oru lets me hang the first lantern on our house."
              ]
            },
            "doing": "at the foot of the ladder, watching the platform for the light"
          }
        },
        "happening": {
          "subject": "item/night-lantern",
          "text": "Oru fills the Night Lantern and lights it at the hearth.",
          "verb": "gains"
        },
        "id": "quest/the-flame",
        "objectives": [
          {
            "happening": {
              "subject": "item/night-lantern",
              "text": "The Night Lantern is lit from the Hearth House fire.",
              "verb": "gains"
            },
            "hint": "Oru waits by the hearth in the Hearth House.",
            "id": "obj/light-the-lantern",
            "npc": "npc/oru",
            "title": "Bring both to Oru",
            "type": "talk-to"
          }
        ],
        "on_complete": [
          {
            "style": "actionbar",
            "text": "The Night Lantern is lit.",
            "type": "narrate"
          }
        ],
        "trigger": {
          "quest": "quest/lantern-and-oil",
          "type": "quest-complete"
        }
      },
      {
        "cast": {
          "npc/hessel": {
            "at": "anchor/node-seed-house",
            "dialogue": {
              "barks": [
                "Lit? Good. My oil, her shade, Oru's fire.",
                "Up the Watch Tree, is it? My knees remember it. Mind the top."
              ]
            },
            "doing": "on a stool by the press, watching the Hearth House"
          },
          "npc/neve": {
            "at": "anchor/node-loom-house",
            "dialogue": "dlg/neve-gate",
            "doing": "at the rope gate, waiting for the lantern"
          },
          "npc/oru": {
            "at": "anchor/node-hearth-house",
            "dialogue": {
              "barks": [
                "Neve will untie the gate when she sees it lit. Go on.",
                "I will watch from here. That is my place tonight."
              ]
            },
            "doing": "at the hearth, looking toward the Watch Tree"
          },
          "npc/tobi": {
            "at": "anchor/node-root-glade",
            "dialogue": {
              "barks": [
                "It's lit! I saw it from here.",
                "You're going all the way up the Watch Tree? All of it?"
              ]
            },
            "doing": "at the foot of the ladder, too pleased to stand still"
          }
        },
        "happening": {
          "subject": "anchor/seam-loom-high",
          "text": "Neve sees the lit lantern and unties the rope gate to the High Bridge.",
          "verb": "opens"
        },
        "id": "quest/the-gate",
        "objectives": [
          {
            "happening": {
              "subject": "anchor/seam-loom-high",
              "text": "Neve unties the rope gate across the High Bridge.",
              "verb": "opens"
            },
            "hint": "Cross the Long Bridge back to the Loom House.",
            "id": "obj/show-neve",
            "npc": "npc/neve",
            "title": "Show Neve the lit lantern",
            "type": "talk-to"
          }
        ],
        "on_complete": [],
        "on_objective_complete": {
          "obj/show-neve": [
            {
              "anchor": "anchor/seam-loom-high",
              "happening": {
                "subject": "anchor/seam-loom-high",
                "text": "The rope gate across the High Bridge falls open.",
                "verb": "opens"
              },
              "type": "open-gate"
            },
            {
              "flag": "flag/gate-untied",
              "type": "set-flag"
            },
            {
              "at": {
                "anchor": "anchor/seam-loom-high",
                "at": "anchor"
              },
              "sound": "minecraft:block.wool.break",
              "type": "play-sound"
            }
          ]
        },
        "trigger": {
          "quest": "quest/the-flame",
          "type": "quest-complete"
        }
      },
      {
        "cast": {
          "npc/hessel": {
            "at": "anchor/node-seed-house",
            "dialogue": {
              "barks": [
                "The planks held tonight. I counted them.",
                "When the top is lit, we answer. Every house, every year."
              ]
            },
            "doing": "at the rail with his own lantern, waiting for the light"
          },
          "npc/neve": {
            "at": "anchor/node-loom-house",
            "dialogue": {
              "barks": [
                "Go on up. The High Bridge is open.",
                "Tell Hessel the rope held tonight. It proves nothing, but tell him."
              ]
            },
            "doing": "by the untied gate, a lantern of her own ready"
          },
          "npc/oru": {
            "at": "anchor/node-hearth-house",
            "dialogue": {
              "barks": [
                "Thirty years I climbed it. Tonight I watch. That is all right.",
                "Hang it on the iron hook at the very top. You will see the hook."
              ]
            },
            "doing": "at the rail of the Hearth House, watching the top of the Watch Tree"
          },
          "npc/tobi": {
            "at": "anchor/node-root-glade",
            "dialogue": {
              "barks": [
                "I can see the ladder from here. I'm not going up it. Tell me what it's like.",
                "When the big lantern's lit, I get to light ours."
              ]
            },
            "doing": "at the foot of the ladder, staring up at the Watch Tree"
          }
        },
        "happening": {
          "subject": "anchor/lantern-hook",
          "text": "The guests climb the Watch Tree and hang the lit lantern at its top, and the camp answers.",
          "verb": "opens"
        },
        "id": "quest/lantern-night",
        "objectives": [
          {
            "anchor": "anchor/lantern-hook",
            "happening": {
              "text": "The guests reach the Crown Lookout at the top of the Watch Tree.",
              "verb": "arrives"

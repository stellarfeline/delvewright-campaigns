              "verb": "opens"
            },
            "hint": "The iron hook hangs over the ring at the top of the tree.",
            "id": "obj/hang-the-lantern",
            "missing_item_hint": "Hold the Night Lantern in your hand to hang it on the hook.",
            "requires_item": "minecraft:lantern",
            "title": "Hang the lantern on the hook",
            "type": "interact"
          }

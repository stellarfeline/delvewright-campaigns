    "nodes": [
      {
        "id": "node/root-glade",
        "intent": "arrival",
        "note": "The ground among the Hearth Tree's buttress roots on its high shelf: fern floor, a lit fire ring, the foot of the first rope ladder. Covered by the Hearth House platform overhead.",
        "size_class": "hall"
      },
      {
        "id": "node/hearth-house",
        "intent": "hall",
        "note": "The highest house and the widest platform, built round the Hearth Tree's trunk: a stone hearth with a fire, benches, two thatched cabins against the trunk.",
        "size_class": "hall"
      },
      {
        "id": "node/hearth-crown",
        "intent": "scenery",
        "note": "The Hearth Tree's crown: thick square branches and chunky leaf masses, 32 across, over the Hearth House and past it. Seen, never entered.",
        "reached": false,
        "size_class": "hall"
      },
      {
        "id": "node/loom-house",
        "intent": "workshop",
        "note": "The lowest house, on the flat top of the topped Loom Tree, open to the sky: two looms under a lean-to, cloth on lines, rope coils, the rope gate across the High Bridge's mouth.",
        "size_class": "room"
      },
      {
        "id": "node/seed-house",
        "intent": "store",
        "note": "Baskets of nuts, drying racks, a log press and a storehouse hut round the Seed Tree's trunk, under its own crown.",
        "size_class": "room"
      },
      {
        "id": "node/watch-roots",
        "intent": "scenery",
        "note": "The Watch Tree's trunk base and buttress roots on the ground. Seen, never entered.",
        "reached": false,
        "size_class": "room"
      },
      {
        "id": "node/watch-house",
        "intent": "lookout",
        "note": "A sentry hut and its platform round the Watch Tree's trunk; the foot of the rope ladder up into the crown.",
        "size_class": "hall"
      },
      {
        "id": "node/watch-crown",
        "intent": "summit",
        "note": "The Watch Tree's crown. The ladder from the Watch House arrives on a plank landing at the first fork; a second ladder climbs the trunk inside the leaves to the Crown Lookout ring with the lantern hook.",
        "size_class": "hall",
        "stations": [
          {
            "anchor": "anchor/lantern-hook",
            "kind": "point",
            "note": "The iron hook at the top of the Crown Lookout ring, where the Night Lantern is hung."
          }
        ]
      },
      {
        "id": "node/long-bridge",

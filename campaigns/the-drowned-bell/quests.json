     },
     {
      "type": "spawn-actor",
      "actor": "actor/barrow-warden"
     },
     {
      "type": "unleash-actor",
      "actor": "actor/barrow-warden"
     },
     {
      "type": "narrate",
      "style": "chat",
      "text": "The Barrow Warden rises out of its kneel, unhurried, like a man standing up from a grave he dug himself, and answers the question you asked."
     }
    ]
   }

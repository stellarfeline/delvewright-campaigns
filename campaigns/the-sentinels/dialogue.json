{
  "campaign_id": "the-sentinels",
  "content": {
    "dialogues": [
      {
        "nodes": [
          {
            "id": "dlg/keeper-root",
            "options": [
              {
                "label": "Can I touch them?",
                "next": "dlg/keeper-touch"
              },
              {
                "label": "Which one is the captain?",
                "next": "dlg/keeper-captain"
              },
              {
                "effects": [
                  {
                    "objective": "obj/hear-the-keeper",
                    "type": "complete-objective"
                  }
                ],
                "label": "Show me the hall."
              }
            ],
            "text": "Welcome to the Sentinel Hall. The old watch, every one of them on the post where they fell asleep. Walk the carpet to the far door and back, and mind your elbows."
          },
          {
            "id": "dlg/keeper-touch",
            "options": [
              {
                "label": "Back.",
                "next": "dlg/keeper-root"
              }
            ],
            "text": "Touch them, strike them, they have had worse. Each one has something to say about it. Nobody here has woken in a hundred years."
          },
          {
            "id": "dlg/keeper-captain",
            "options": [
              {
                "label": "Back.",
                "next": "dlg/keeper-root"
              }
            ],
            "text": "The last figure on your left as you walk down, the one in full iron with his sword still drawn. Leave him till last. He was always a light sleeper."
          }
        ],
        "npc": "npc/keeper",
        "root": "dlg/keeper-root"
      },
      {
        "nodes": [
          {
            "id": "dlg/door-ward-root",
            "options": [
              {
                "label": "Step back."
              }
            ],
            "text": "The dry figure leans against the wall by the door. Sand runs out of its sleeve when you come close."
          }
        ],
        "npc": "npc/door-ward",
        "root": "dlg/door-ward-root"
      }
    ]
  },
  "dsl_version": "0.60.0",
  "stage": "dialogue"
}

            "id": "dlg/rung-newhigh",
            "options": [
              {
                "label": "Another sentence.",
                "next": "dlg/sky"
              }
            ],
            "text": "The bell rings. Look straight up: the same hour as the full moon, four days on, and the moon overhead is new."

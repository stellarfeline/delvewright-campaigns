            "options": [
              {
                "effects": [
                  {
                    "objective": "obj/hear-the-ferryman",
                    "type": "complete-objective"
                  }
                ],
                "happening": {
                  "subject": "npc/ferryman",
                  "text": "Hobb tells them the last crossing has gone and sends them up onto the quay to wait.",
                  "verb": "learns"
                },
                "label": "I'll wait on the quay."
              }
            ],
            "text": "Last crossing's gone for tonight. The morning boat goes from here at first light. Wait up on the quay if you like; it's drier up there."
          }
        ],
        "npc": "npc/ferryman",
        "root": "dlg/ferryman-root"
      },
      {
        "nodes": [
          {
            "id": "dlg/wenna-root",
            "text": "The toll is paid at the boat, not to us. My sister and I only keep the book."
          }
        ],
        "npc": "npc/wenna",
        "root": "dlg/wenna-root"
      },
      {
        "nodes": [
          {
            "id": "dlg/morwen-root",
            "text": "I'm Morwen. Wenna is the elder, by a quarter of an hour, and she never lets me forget it."
          }
        ],
        "npc": "npc/morwen",
        "root": "dlg/morwen-root"
      },
      {
        "nodes": [
          {
            "id": "dlg/pilgrim-root",
            "text": "I am going over to the shrine on the far shore. I have waited on this landing since noon."
          }
        ],
        "npc": "npc/pilgrim",
        "root": "dlg/pilgrim-root"
      },
      {
        "nodes": [
          {
            "id": "dlg/clerk-root",
            "text": "Every crossing goes into the harbour book. Nothing has crossed since the last boat."
          }
        ],
        "npc": "npc/clerk",
        "root": "dlg/clerk-root"
      }
    ]
  },

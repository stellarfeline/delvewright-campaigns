{
  "dsl_version": "0.4.0",
  "campaign_id": "nobodys-cave",
  "stage": "quests",
  "content": {
    "quests": [
      {
        "id": "quest/the-cave-invites",
        "trigger": { "type": "campaign-start" },
        "objectives": [
          {
            "type": "talk-to",
            "id": "obj/the-argument",
            "npc": "npc/eurylochus",
            "title": "Hear Eurylochus Out",
            "hint": "He is on the sand beside you, and he will not let this go until you answer him one way or the other."
          }
        ],
        "on_objective_complete": {
          "obj/the-argument": [
            { "type": "set-flag", "flag": "flag/overruled" }
          ]
        },
        "on_complete": []
      },
      {
        "id": "quest/the-boulder-falls",
        "trigger": { "type": "quest-complete", "quest": "quest/the-cave-invites" },
        "objectives": [
          {
            "type": "talk-to",
            "id": "obj/the-stone",
            "npc": "npc/perimedes",
            "requires_flags": ["flag/overruled"],
            "title": "Find Perimedes",
            "hint": "He is just inside the mouth of the cave, crouched where the stone came down."
          }
        ],
        "on_objective_complete": {
          "obj/the-stone": [
            { "type": "open-gate", "anchor": "anchor/gate" },
            { "type": "spawn-wave", "wave": "wave/the-flock" },
            { "type": "set-flag", "flag": "flag/sealed" },
            {
              "type": "narrate",
              "style": "title",
              "text": "Sealed In",
              "sound": "minecraft:entity.wither.break_block"
            },
            {
              "type": "narrate",
              "style": "subtitle",
              "text": "Stone grinds across the mouth, and the daylight narrows to a line, and then to nothing."
            },
            {
              "type": "cutscene",
              "seconds": 5,
              "path": [
                { "anchor": "anchor/exit", "offset": [0, 1, 4] },
                { "anchor": "anchor/exit", "offset": [0, 1, 1] }
              ]
            }
          ]
        },
        "on_complete": []
      },
      {
        "id": "quest/nobody",
        "trigger": { "type": "quest-complete", "quest": "quest/the-boulder-falls" },
        "objectives": [
          {
            "type": "talk-to",
            "id": "obj/the-name",
            "npc": "npc/polyphemus",
            "requires_flags": ["flag/sealed"],
            "title": "Give the Giant a Name",
            "hint": "Polyphemus is deep inside — past the opened stone, past the pens, at the great hearth at the far end. Go and talk to him before you help yourself to anything of his."
          }
        ],
        "on_objective_complete": {
          "obj/the-name": [
            { "type": "set-flag", "flag": "flag/named" },
            { "type": "set-block", "anchor": "anchor/objective", "block": "minecraft:decorated_pot" },
            {
              "type": "narrate",
              "style": "chat",
              "text": "The wine does its work. The giant's chin sinks to his chest, and the whole cave fills with the sound of him sleeping."
            }
          ]
        },
        "on_complete": []
      },
      {
        "id": "quest/the-stake",
        "trigger": { "type": "quest-complete", "quest": "quest/nobody" },
        "objectives": [
          {
            "type": "collect",
            "id": "obj/olive-beam",
            "item": "minecraft:stripped_oak_log",
            "count": 1,
            "anchor": "anchor/chest",
            "requires_flags": ["flag/named"],
            "title": "Cut the Olive Beam",
            "hint": "Past the stone Polyphemus rolled aside, the sheep pens are stacked with his cut timber — the olive beam is in the chest among them."
          },
          {
            "type": "interact",
            "id": "obj/sharpen",
            "anchor": "anchor/door",
            "prop": { "block": "minecraft:grindstone" },
            "requires_item": "minecraft:stripped_oak_log",
            "after": ["obj/olive-beam"],
            "title": "Grind the Point",
            "hint": "Carry the beam back toward the mouth, near where Perimedes is waiting — the giant keeps a grinding stone there for his own tools."
          },
          {
            "type": "interact",
            "id": "obj/harden",
            "anchor": "anchor/boss",
            "prop": { "block": "minecraft:campfire" },
            "after": ["obj/sharpen"],
            "requires_flags": ["flag/sharpened"],
            "title": "Harden it in the Fire",
            "hint": "His hearth burns deeper in, beside where he sleeps. Turn the point in the coals until it blackens."
          },
          {
            "type": "talk-to",
            "id": "obj/blind",
            "npc": "npc/polyphemus",
            "after": ["obj/harden"],
            "requires_flags": ["flag/hardened"],
            "title": "Put Out the Eye",
            "hint": "He went down where the wine took him, at his own hearth. Go back to him with the hardened stake."
          }
        ],
        "on_objective_complete": {
          "obj/sharpen": [
            { "type": "set-flag", "flag": "flag/sharpened" }
          ],
          "obj/harden": [
            { "type": "set-flag", "flag": "flag/hardened" }
          ],
          "obj/blind": [
            { "type": "despawn-npc", "npc": "npc/polyphemus" },
            { "type": "set-block", "anchor": "anchor/objective", "block": "minecraft:air" },
            { "type": "spawn-wave", "wave": "wave/blinded-polyphemus" },
            { "type": "set-flag", "flag": "flag/blinded" },
            {
              "type": "narrate",
              "style": "title",
              "text": "He Rises Blind",
              "sound": "minecraft:entity.warden.roar"
            },
            {
              "type": "narrate",
              "style": "subtitle",
              "text": "Get out of the cave. Make no sound he can follow."
            }
          ]
        },
        "on_complete": []
      },
      {
        "id": "quest/under-the-rams",
        "trigger": { "type": "quest-complete", "quest": "quest/the-stake" },
        "objectives": [
          {
            "type": "reach-anchor",
            "id": "obj/the-ram",
            "anchor": "anchor/wave",
            "radius": 3,
            "requires_flags": ["flag/blinded"],
            "stealth": true,
            "title": "Get Under a Ram",
            "hint": "Leave him roaring at his hearth and slip in among the flock down the cavern from him — get underneath a ram and take hold of the fleece, and let it carry you out past his hands. Do not run and do not jump; he hunts by sound now."
          },
          {
            "type": "talk-to",
            "id": "obj/hold-fast",
            "npc": "npc/perimedes",
            "after": ["obj/the-ram"],
            "requires_flags": ["flag/aboard"],
            "title": "Go Out With the Flock",
            "hint": "Perimedes is waiting back at the mouth of the cave, in among the rams. Get to him before the flock is through."
          }
        ],
        "on_objective_complete": {
          "obj/the-ram": [
            { "type": "set-flag", "flag": "flag/aboard" },
            {
              "type": "narrate",
              "style": "chat",
              "text": "Two fistfuls of wool, close in at the belly where it is thickest. The ram walks, and you walk out under it."
            }
          ]
        },
        "on_complete": []
      },
      {
        "id": "quest/the-name-you-shout",
        "trigger": { "type": "quest-complete", "quest": "quest/under-the-rams" },
        "objectives": [
          {
            "type": "talk-to",
            "id": "obj/the-shout",
            "npc": "npc/eurylochus",
            "requires_flags": ["flag/aboard"],
            "title": "The Ship Is Waiting",
            "hint": "Eurylochus is at the water's edge with the oars manned. Tell him how you want to leave."
          }
        ],
        "on_objective_complete": {},
        "on_complete": [
          { "type": "campaign-complete" }
        ]
      }
    ],
    "waves": [
      {
        "id": "wave/the-flock",
        "anchor": "anchor/wave",
        "mobs": [
          { "entity": "minecraft:sheep", "count": 6, "name": "Ram of the Cave" }
        ]
      },
      {
        "id": "wave/blinded-polyphemus",
        "anchor": "anchor/objective",
        "mobs": [
          {
            "entity": "minecraft:warden",
            "count": 1,
            "name": "Polyphemus, Blinded",
            "attributes": {
              "max_health": 30.0,
              "movement_speed": 0.05,
              "follow_range": 1.0,
              "attack_damage": 2.0
            },
            "effects": [
              { "effect": "minecraft:slowness", "amplifier": 4 }
            ]
          }
        ]
      }
    ],
    "triggers": [
      {
        "id": "trigger/the-stone",
        "at": "anchor/gate",
        "on": { "on": "strike" },
        "once": false,
        "effects": [
          {
            "type": "narrate",
            "style": "subtitle",
            "text": "You set your shoulder to the great stone. It does not so much as grind. No blade you carry will bite it — whatever opens this cave, it will not be you.",
            "sound": "minecraft:block.stone.hit"
          }
        ]
      }
    ]
  }
}

    "quests": [
      {
        "cast": {},
        "happening": {
          "subject": "anchor/bell",
          "text": "The party comes in at the lychgate at dusk to ring the passing bell that nobody has rung in forty years.",
          "verb": "arrives"
        },
        "id": "quest/ring-the-passing-bell",
        "objectives": [
          {
            "anchor": "anchor/threshold",
            "happening": {
              "subject": "anchor/threshold",
              "text": "The party steps in out of the yard under the chapel roof, and the yard's tune falls away behind them.",
              "verb": "arrives"
            },
            "hint": "Up the flagstone path through the stones, in at the chapel door.",
            "id": "obj/enter-the-chapel",
            "radius": 2,
            "title": "Go into the chapel",
            "type": "reach-anchor"
          },
          {
            "after": [
              "obj/enter-the-chapel"
            ],
            "anchor": "anchor/bell",
            "happening": {
              "subject": "anchor/bell",
              "text": "The passing bell rings for the names on the stones, and the yard takes up a different tune.",

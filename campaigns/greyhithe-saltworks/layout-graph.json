    "nodes": [
      {
        "id": "node/tide-landing",
        "intent": "where the party is put ashore and where the works first shows itself",
        "note": "The shingle under the north cliff. The works stands above and south; the light on the headland is one spark at the far end of the sight.",
        "size_class": "hall",
        "stations": [
          {
            "anchor": "anchor/teague-stand",
            "kind": "point",
            "note": "Where the pilot stands with the boat behind her."
          }
        ]
      },
      {
        "id": "node/drowned-pans",
        "intent": "the lower pans the sea took, crossed at low water",
        "note": "Six evaporating pans with their walls broken. Crossing it is the first cost the delve charges.",
        "size_class": "expanse"
      },
      {
        "id": "node/pan-house",
        "intent": "the last shed standing on the pans, and the first shelter",
        "note": "Low, salt-eaten, a door at each end. The first place a body stands out of the wind.",
        "size_class": "room"
      },
      {
        "id": "node/wreck-stair",
        "intent": "the cut stair off the pans, climbing the face to the works",
        "note": "Cut by the same hands that cut the brine gallery above it.",
        "way_class": "road"
      },
      {
        "id": "node/brine-gallery",
        "intent": "the rock-cut gallery that carried brine up to the pans",
        "note": "Pipe cradles still bolted to the rock. It is the works' own throat.",
        "way_class": "corridor"
      },
      {
        "id": "node/boiling-house",
        "intent": "the great boiling house, the building the delve is named after",
        "note": "Four lead pans over four furnaces under a clerestory the whole length of it. The one interior with height.",
        "size_class": "hall",
        "stations": [
          {
            "anchor": "anchor/first-pan",
            "kind": "point",
            "note": "The first of the four pans, the one the story keeps coming back to."
          }
        ]
      },
      {
        "id": "node/furnace-walk",
        "intent": "the stoking walk behind the furnaces",
        "note": "Black and close, directly behind the fires the boiling house is heated by.",
        "way_class": "corridor"
      },
      {
        "id": "node/coal-yard",
        "intent": "the yard where coal was landed and stacked",
        "note": "Open to the sky, walled to the sea. Where the works met the world.",
        "size_class": "hall"
      },
      {
        "id": "node/hoist-tower",
        "intent": "the hoist that lifted coal from the yard to the store",
        "note": "A narrow tower with its wheel still in it: the works' one vertical interior.",
        "size_class": "room",
        "stations": [
          {
            "anchor": "anchor/hask-bench",
            "kind": "point",
            "note": "The engineman's bench under the wheel."
          }
        ]
      },
      {
        "id": "node/salt-store",
        "intent": "the dry store where finished salt was kept",
        "note": "High windows down the long wall, floor swept to bare stone. The driest room on the site.",
        "size_class": "hall",
        "stations": [
          {
            "anchor": "anchor/pyke-camp",
            "kind": "point",
            "note": "The wrecker's camp against the dry wall."
          }
        ]
      },
      {
        "id": "node/cooperage",
        "intent": "the barrel shop that packed the salt",
        "note": "Half-made casks on the bench and hoops on the wall.",
        "size_class": "room"
      },
      {
        "id": "node/works-yard",
        "intent": "the yard the works and the abbey share, and the hinge of the map",
        "note": "Everything walked so far opens onto it, and the abbey gate stands across it.",
        "size_class": "hall",
        "stations": [
          {
            "anchor": "anchor/gate-bar",
            "kind": "point",
            "note": "The stone the bar's far end drops into, on the yard side of the gate."
          }
        ]
      },
      {
        "id": "node/abbey-gate",
        "intent": "the abbey gatehouse, barred from the inside",
        "note": "The one way into the precinct, and the delve's first held door.",
        "size_class": "room"
      },
      {
        "id": "node/cloister-garth",
        "intent": "the garth the abbey buildings stand around",
        "note": "Open to the sky, walks on four sides, a well in the middle gone to salt.",
        "size_class": "hall"
      },
      {
        "id": "node/cloister-walk",
        "intent": "the north walk, the covered route between the abbey rooms",
        "note": "Arcaded on the garth side: the abbey's one way of letting light in, repeated the length of it.",
        "way_class": "corridor"
      },
      {
        "id": "node/chapter-house",
        "intent": "the chapter house, where the party can rest",
        "note": "Stone bench round the wall, one high window, and nothing that can reach in.",
        "size_class": "room",
        "stations": [
          {
            "anchor": "anchor/hearth",
            "kind": "point",
            "note": "The fire. The one warm place in the precinct."
          }
        ]
      },
      {
        "id": "node/refectory",
        "intent": "the refectory, where the community ate and where it stopped",
        "note": "Tables still laid. What happened here is the delve's middle revelation.",
        "size_class": "hall",
        "stations": [
          {
            "anchor": "anchor/high-table",
            "kind": "point",
            "note": "The high table, still laid."
          },
          {
            "anchor": "anchor/low-table",
            "kind": "point",
            "note": "The low end of the hall, where a cellarer counts what nobody ate."
          }
        ]
      },
      {
        "id": "node/abbey-church",
        "intent": "the abbey church, the tallest thing on the headland after the light",
        "note": "Clerestory windows both sides, the same rhythm as the boiling house. One hand built both.",
        "size_class": "hall"
      },
      {
        "id": "node/undercroft",
        "intent": "the undercroft beneath the church, where the abbey kept what it would not say",
        "note": "Reached by a stair off the church floor. Low, dry, and the only place the delve goes down.",
        "size_class": "room",
        "stations": [
          {
            "anchor": "anchor/ledger-chest",
            "kind": "point",
            "note": "The sea office's chest, at the far end under the vault."
          }
        ]
      },
      {
        "id": "node/prior-lodging",
        "intent": "the prior's lodging, the last room anyone lived in",
        "note": "A bed, a desk, and a ledger nobody closed.",
        "size_class": "room",
        "stations": [
          {
            "anchor": "anchor/prior-desk",
            "kind": "point",
            "note": "The desk, and what is still sitting at it."
          }
        ]
      },
      {
        "id": "node/night-stair",
        "intent": "the night stair head, where the precinct ends and the headland begins",
        "note": "Built so the community could reach the light in the dark without going outside.",
        "way_class": "corridor"
      },
      {
        "id": "node/headland-path",
        "intent": "the exposed path along the headland to the light",
        "note": "No cover, sea on both sides. From here the whole site reads as one silhouette.",
        "way_class": "road"
      },
      {
        "id": "node/light-court",
        "intent": "the walled court at the foot of the light, where the delve is decided",
        "note": "Walled to keep the weather off the fuel, which is what makes it a room and not a clifftop.",
        "size_class": "arena",
        "stations": [
          {
            "anchor": "anchor/keeper-stand",
            "kind": "point",
            "note": "Where the keeper meets whoever comes up the headland."
          }
        ]
      },
      {
        "id": "node/lantern-room",
        "intent": "the lantern room at the top of the light",
        "note": "The last place. Whoever has been tending it has been standing here.",
        "size_class": "alcove",
        "stations": [
          {
            "anchor": "anchor/lantern",
            "kind": "point",
            "note": "The lamp itself."
          }
        ]
      }
    ]
  },

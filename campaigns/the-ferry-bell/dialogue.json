{
  "campaign_id": "the-ferry-bell",
  "content": {
    "dialogues": [
      {
        "nodes": [
          {
            "id": "dlg/nell-root",
            "options": [
              {
                "label": "Why not ring it?",
                "next": "dlg/nell-why"
              },
              {
                "label": "Where is the bell?",
                "next": "dlg/nell-where"
              },
              {
                "effects": [
                  {
                    "objective": "obj/hear-nell",
                    "type": "complete-objective"
                  }
                ],
                "label": "I'll ring it."
              }
            ],
            "text": "You'll be wanting the ferry. It lies over on the far side of the sound, and it only crosses for the bell. I won't ring that bell on my own. Not with this arm."
          },
          {
            "id": "dlg/nell-why",
            "options": [
              {
                "label": "Where is the bell?",
                "next": "dlg/nell-where"
              },
              {
                "effects": [
                  {
                    "objective": "obj/hear-nell",
                    "type": "complete-objective"
                  }
                ],
                "label": "I'll ring it."
              }
            ],
            "text": "The last three times it rang, the dead came up out of the cove onto the spit there, across the water. They make for whoever rang it. I'd want somebody beside me who can hold a blade."
          },
          {
            "id": "dlg/nell-where",
            "options": [
              {
                "label": "Why not ring it?",
                "next": "dlg/nell-why"
              },
              {
                "effects": [
                  {
                    "objective": "obj/hear-nell",
                    "type": "complete-objective"
                  }
                ],
                "label": "I'll ring it."
              }
            ],
            "text": "In the ferry house, at the end of the jetty. The door's bolted from the jetty side. The slate on the post there, behind you on the right, has it all in chalk."
          }
        ],
        "npc": "npc/nell",
        "root": "dlg/nell-root"
      }
    ]
  },

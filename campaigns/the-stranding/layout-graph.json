    "entry": "node/coach-road",
    "goal": "node/pier",
    "nodes": [
      {
        "id": "node/coach-road",
        "intent": "arrival",
        "note": "The cobbled coach road along the cliff top, a drystone parapet on the drop and the rock bank behind; the coach stop's timber shelter at its east end.",
        "stations": [
          {
            "anchor": "anchor/coach-stop",
            "kind": "point",
            "note": "the notice on the coach stop's post"
          }
        ]
      },
      {
        "id": "node/cliff-steps",
        "intent": "descent",
        "note": "The covered steps down the cliff from the coach road to the head of the High Street."
      },
      {
        "id": "node/high-street",
        "intent": "street",
        "note": "The High Street between two terraces of tall slate-roofed houses; sleepers stand in the open doorways facing the sea."
      },
      {
        "id": "node/harbour-lane",
        "intent": "quay",
        "note": "The harbour lane along the north quay: the office, the cottage, the lofts and the market open off it; the basin lies below its quay edge."
      },
      {
        "id": "node/harbour-office",
        "intent": "office",
        "note": "Wenna Coyle's office: the tide board stuck at low, the desk, a window over the harbour."
      },
      {
        "id": "node/coyle-house",
        "intent": "cottage",
        "note": "A single-storey limewashed cottage: Davey's room, the soaked bed, the footprints, the wool picture.",
        "stations": [
          {
            "anchor": "anchor/wool-picture",
            "kind": "point",
            "note": "Davey's picture of the dream in coloured wool"
          }
        ]
      },
      {
        "id": "node/net-lofts",
        "intent": "loft",
        "note": "A plank loft over the harbour up a stair, nets and floats, a sleeper at the loft door."
      },
      {
        "id": "node/boatyard",
        "intent": "arena",
        "note": "The emptied harbour basin: the town's boats lie on their sides on the mud.",
        "stations": [
          {
            "anchor": "anchor/shipwright-note",
            "kind": "point",
            "note": "the shipwright's note nailed to a hull"
          }
        ]
      },
      {
        "id": "node/fish-market",
        "intent": "arena",
        "note": "The covered fish market hall: stone slabs, barrels, nets; its sea doors open on the slipway up out of the basin.",
        "stations": [
          {
            "anchor": "anchor/market-slate",
            "kind": "point",
            "note": "the market slate where the day's catch is chalked"
          }
        ]
      },
      {
        "id": "node/seawall",
        "intent": "threshold",
        "note": "The seawall along the town's south front, a parapet over the flat; the threshold of the wrong place.",
        "stations": [
          {
            "anchor": "anchor/customs-lock",
            "kind": "point",
            "note": "the padlock on the Customs House door"
          }
        ]
      },
      {
        "id": "node/seamens-chapel",

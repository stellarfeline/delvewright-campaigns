     {
      "type": "talk-to",
      "id": "obj/the-name",
      "npc": "npc/polyphemus",
      "requires_flags": [
       "flag/sealed"
      ],
      "title": "Meet the Owner of the Cave",
      "hint": "Polyphemus sits at the great fire at the heart of the hall. Go to him before you touch anything else of his, and mind your manners about the wine."
     }
    ],
    "on_objective_complete": {
     "obj/the-name": [
      {
       "type": "set-flag",
       "flag": "flag/asleep"
      },
      {
       "type": "narrate",
       "style": "chat",
       "text": "The wine of Maron does its work. His chin sinks to his chest, and the whole cave fills with the long tide of his breathing."
      },
      {
       "type": "play-sound",
       "sound": "minecraft:entity.generic.drink",
       "at": {
        "at": "anchor",
        "anchor": "anchor/fire-pit"
       }
      },
      {
       "type": "play-sound",
       "sound": "minecraft:entity.warden.ambient",
       "at": {
        "at": "anchor",
        "anchor": "anchor/fire-pit"
       }
      }
     ]
    },
    "on_complete": [
     {
      "type": "give-item",
      "item": "minecraft:stripped_oak_log",
      "count": 1,
      "name": "Green Olive Stake"
     },
     {
      "type": "narrate",
      "style": "chat",
      "text": "Perimedes drags a beam of green olive-wood from the giant's stacked timber and puts it in your hands. \"Big as a mast, Captain. We cut it down to a point.\""
     }
    ]
   },

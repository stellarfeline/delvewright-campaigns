  "quests": [
   {
    "id": "quest/shipwrecked",
    "trigger": {
     "type": "campaign-start"
    },
    "objectives": [
     {
      "type": "talk-to",
      "id": "obj/muster",
      "npc": "npc/eurylochus",
      "title": "Hear Eurylochus Out",
      "hint": "He stands at the class-post by the driftwood fire, a few steps up the sand from where you woke."
     },
     {
      "type": "kill",
      "id": "obj/surf",
      "wave": "wave/surf",
      "after": [
       "obj/muster"
      ],
      "title": "Drive Off the Drowned",
      "hint": "Three drowned haul themselves out of the surf at the waterline, west of the fire. Cut them down before they reach the crew."
     },
     {
      "type": "talk-to",
      "id": "obj/climb-out",
      "npc": "npc/eurylochus",
      "after": [
       "obj/surf"
      ],
      "title": "Tell Eurylochus You Will Climb",
      "hint": "He is still at the fire, watching the smoke on the mountain. Give him the word to lead on."
     }
    ],
    "on_objective_complete": {
     "obj/muster": [
      {
       "type": "set-time",
       "time": "night"
      },
      {
       "type": "narrate",
       "style": "chat",
       "text": "The sun drops fast behind the world's rim, the way it does at sea. In the last red light, the surf begins to move."
      },
      {
       "type": "spawn-wave",
       "wave": "wave/surf"
      },
      {
       "type": "narrate",
       "style": "chat",
       "text": "The surf gives up its dead: three drowned wade out of the shallows toward the fire."
      },
      {
       "type": "play-sound",
       "sound": "minecraft:entity.hostile.splash",
       "at": {
        "at": "anchor",
        "anchor": "anchor/surf-wave"
       }
      },
      {
       "type": "play-sound",
       "sound": "minecraft:entity.drowned.ambient",
       "at": {
        "at": "anchor",
        "anchor": "anchor/surf-wave"
       }
      }
     ],
     "obj/surf": [
      {
       "type": "narrate",
       "style": "chat",
       "text": "The last of them slides back under the foam. The beach is yours for as long as the light lasts."
      }
     ],
     "obj/climb-out": [
      {
       "type": "move-npc",
       "npc": "npc/eurylochus",
       "to_anchor": "anchor/mouth"
      },
      {
       "type": "narrate",
       "style": "chat",
       "text": "Eurylochus shoulders a coil of rope and starts up the worn path. Follow the smoke."
      },
      {
       "type": "play-sound",
       "sound": "minecraft:block.campfire.crackle",
       "at": {
        "at": "anchor",
        "anchor": "anchor/camp-fire"
       }
      },
      {
       "type": "give-item",
       "item": "minecraft:honey_bottle",
       "count": 1,
       "name": "Skin of Maron's Wine"
      }
     ]
    },
    "on_complete": [
     {
      "type": "narrate",
      "style": "chat",
      "text": "Antiphos hoists the wine and the meal-sacks onto one shoulder. \"Somebody carries the man's dinner,\" he says, and falls in behind you. Elpenor stays with the fire — alone, and burning it high."
     },
     {
      "type": "move-npc",
      "npc": "npc/antiphos",
      "to_anchor": "anchor/mouth",
      "on_arrive": [
       {
        "type": "narrate",
        "style": "chat",
        "text": "Antiphos sets the sacks down in the light of the mouth and stays there, catching his wind and counting lambs."
       },
       {
        "type": "set-flag",
        "flag": "flag/antiphos-posted"
       }
      ]
     }
    ]
   },
   {
    "id": "quest/follow-the-smoke",
    "trigger": {
     "type": "quest-complete",
     "quest": "quest/shipwrecked"
    },
    "objectives": [
     {
      "type": "reach-anchor",
      "id": "obj/reach-mouth",
      "anchor": "anchor/mouth",
      "radius": 3,
      "title": "Follow Eurylochus to the Cave",
      "hint": "Climb up off the sand behind him: through the grazing meadow, past the low stone sheep-fold standing walled and empty, and up the switchbacks of the mountain's face to the smoking cave mouth where the great boulder rests."
     }
    ],
    "on_objective_complete": {
     "obj/reach-mouth": [
      {
       "type": "move-npc",
       "npc": "npc/eurylochus",
       "to_anchor": "anchor/checkpoint-1"
      },
      {
       "type": "narrate",
       "style": "chat",
       "text": "The mouth breathes cool air and old smoke. Eurylochus steps inside ahead of you."
      },
      {
       "type": "play-sound",
       "sound": "minecraft:entity.sheep.ambient",
       "at": {
        "at": "players"
       }
      },
      {
       "type": "play-sound",
       "sound": "minecraft:ambient.cave",
       "at": {
        "at": "anchor",
        "anchor": "anchor/mouth"
       }
      }
     ]
    },
    "on_complete": []
   },
   {
    "id": "quest/cave-of-plenty",
    "trigger": {
     "type": "quest-complete",
     "quest": "quest/follow-the-smoke"
    },
    "objectives": [
     {
      "type": "reach-anchor",
      "id": "obj/checkpoint",
      "anchor": "anchor/checkpoint-1",
      "radius": 2,
      "title": "Step Into the Cave",
      "hint": "Move in past the mouth to the first broad shelf of the hall, where the racks begin."
     },
     {
      "type": "collect",
      "id": "obj/cheese",
      "anchor": "anchor/cheese-store",
      "after": [
       "obj/checkpoint"
      ],
      "title": "Take a Wheel of Cheese",
      "hint": "The cheese is racked on the shelves by the entry. Take a wheel from the barrel among them.",
      "item": "minecraft:sponge",
      "count": 1
     },
     {
      "type": "talk-to",
      "id": "obj/the-argument",
      "npc": "npc/eurylochus",
      "after": [
       "obj/cheese"
      ],
      "title": "Decide With Eurylochus",
      "hint": "He is at your shoulder by the cheese racks. Tell him whether you run for the ship or wait for the owner of this cave."
     }
    ],
    "on_objective_complete": {
     "obj/checkpoint": [
      {
       "type": "set-checkpoint",
       "anchor": "anchor/checkpoint-1",
       "on_respawn": [
        {
         "type": "narrate",
         "style": "chat",
         "text": "You come to against the cold shelf inside the mouth, cheese-smell and old smoke in your throat."
        }
       ]
      },
      {
       "type": "narrate",
       "style": "chat",
       "text": "Cheese racked to the roof. Lambs penned and sorted by age. Pails still wet, and nobody home. This is not an empty house. It is a house someone is coming back to."
      },
      {
       "type": "play-sound",
       "sound": "minecraft:ambient.cave",
       "at": {
        "at": "anchor",
        "anchor": "anchor/checkpoint-1"
       }
      },
      {
       "type": "spawn-npc",
       "npc": "npc/perimedes"
      },
      {
       "type": "move-npc",
       "npc": "npc/perimedes",
       "to_anchor": "anchor/alcove-2"
      },
      {
       "type": "narrate",
       "style": "chat",
       "text": "Perimedes slips in at your heel with the ship's wine-skin on his shoulder, reads the whole hall once, and puts his back to the recess beside the racks."
      }
     ],
     "obj/cheese": [
      {
       "type": "narrate",
       "style": "chat",
       "text": "A wheel of hard yellow cheese, heavy as a shield. Perimedes presses the wine-skin from the ship into your other hand: \"Carried it up myself, Captain. In case a stranger needs making a guest.\""
      }
     ],
     "obj/the-argument": [
      {
       "type": "set-flag",
       "flag": "flag/wait",
       "requires_flags": [
        "flag/wait"
       ]
      },
      {
       "type": "set-flag",
       "flag": "flag/flee",
       "requires_flags": [
        "flag/flee"
       ]
      },
      {
       "type": "move-npc",
       "npc": "npc/perimedes",
       "to_anchor": "anchor/mouth",
       "requires_flags": [
        "flag/flee"
       ],
       "on_arrive": [
        {
         "type": "narrate",
         "style": "chat",
         "text": "Perimedes is through the mouth before you finish speaking — out first, counting heads onto the sand."
        },
        {
         "type": "despawn-npc",
         "npc": "npc/perimedes"
        }
       ]
      },
      {
       "type": "move-npc",
       "npc": "npc/antiphos",
       "to_anchor": "anchor/crew-a",
       "requires_flags": [
        "flag/flee"
       ],
       "on_arrive": [
        {
         "type": "narrate",
         "style": "chat",
         "text": "Antiphos shoulders the sacks without a word and starts down. Arithmetic, Captain: everything you came in with, and one wheel of cheese to the good."
        }
       ]
      }
     ]
    },
    "on_complete": [
     {
      "type": "move-npc",
      "npc": "npc/eurylochus",
      "to_anchor": "anchor/alcove-1",
      "requires_flags": [
       "flag/wait"
      ],
      "on_arrive": [
       {
        "type": "set-flag",
        "flag": "flag/eury-hidden"
       },
       {
        "type": "narrate",
        "style": "chat",
        "text": "Eurylochus presses himself into the recess beside you, sword drawn and pointless, breathing through his teeth."
       }
      ]
     }
    ]
   },
   {
    "id": "quest/take-the-cheese",
    "trigger": {
     "type": "quest-complete",
     "quest": "quest/cave-of-plenty"
    },
    "objectives": [
     {
      "type": "reach-anchor",
      "id": "obj/flee-back",
      "anchor": "anchor/gangplank",
      "radius": 3,
      "requires_flags": [
       "flag/flee"
      ],
      "title": "Run for the Ship",
      "hint": "Back down the mountain the way you climbed, past the fold and the fire, to the gangplank where the galley waits."
     },
     {
      "type": "interact",
      "id": "obj/board-flee",
      "anchor": "anchor/deck",
      "after": [
       "obj/flee-back"
      ],
      "requires_flags": [
       "flag/flee"
      ],
      "title": "Board the Galley",
      "hint": "Cross the gangplank and take your place at the oars while the cave is still empty behind you."
     }
    ],
    "on_objective_complete": {
     "obj/flee-back": [
      {
       "type": "narrate",
       "style": "chat",
       "text": "Cheese in the crook of your arm, the lambs left complaining in their pens. No song will ever be made of this. You will simply get home."
      }
     ],
     "obj/board-flee": [
      {
       "type": "narrate",
       "style": "title",
       "text": "THE QUIET SAIL"
      },
      {
       "type": "narrate",
       "style": "chat",
       "text": "Ithaca inside the month. Safe, and fed, and a little smaller for it — and every man you came in with still at his oar."
      },
      {
       "type": "play-sound",
       "sound": "minecraft:entity.villager.celebrate",
       "at": {
        "at": "players"
       }
      },
      {
       "type": "campaign-complete"
      }
     ]
    },
    "on_complete": []
   },

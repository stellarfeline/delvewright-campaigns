    "no_body": {
      "z0/cairn/heaps": {
        "reason": "the cairn field -- one heap per body recovered off this shore; a heap has a top and nobody stands on it"
      },
      "z0/mud/heaps": {
        "reason": "the heaps out in the mire, the same cairns the tide has already taken"
      },
      "z0/stake/tops": {
        "reason": "the iron tops of the tide-stake line: what the water is read against, never a step"
      },
      "z0/crag/steps": {
        "reason": "the crag's batter, stepping back one course in three -- a cliff read from the sand, and the reason the cut ledge is the only way up"
      },
      "z0/shelf/coping": {
        "reason": "the coping of the shelf's front wall and the head of the lamp cell, seen from the flat below"
      },
      "z1/teeth": {
        "reason": "the rock teeth standing in the surf at the cliff's foot, twelve courses under the walking line: what the drop ends on, and never ground the road offers a body"
      },
      "z1/stand-backs": {
        "reason": "the recesses cut into the inner wall: one body deep, so a thing that waits in one is not on the road until it steps out, and the walking line stays single-file past it"
      },
      "z2/gate/lodge": {
        "reason": "the porter's lodge, grated shut across its own embrasure; the crossing-ledger is inside and the gate key is what opens it"
      },
      "z2/gate/wall-head": {
        "reason": "the ward curtain's own wall-head over the yard and the causeway head -- dressing read from below, never floor"
      },
      "z3/arcade/ruin": {
        "reason": "the west arcade as the sea has left it: pier stone holed through, a deck with no way up to it, and the voids the collapse closed inside the masonry"
      },
      "z3/ward/tide": {
        "reason": "the flooded ward — the sea standing over the ward floor, inside the arches, around the wrecks and against the tower base. The spine is walkable at the standing tide and the ward is not"
      },
      "z4/canopy": {
        "reason": "the chapel canopy where it came down: broken timber to fight around, standable only because a heap has a top"
      },
      "z4/rubble": {
        "reason": "fallen masonry heaped along the west walk, and what is lying in it: cover to read and a body to mistake for scenery, never floor to cross"
      },
      "z4/stations": {
        "reason": "the three plinths of the hour-round: the bell is set down on them and nobody stands there"
      },
      "z5/gallery/perch": {
        "reason": "the bait perch over the gallery floor -- a timber shelf a watcher stands on, with no stair to it"
      },
      "z5/hall/corbels": {
        "reason": "the two corbels at the truss ends, where a watcher is placed over the hall"
      },
      "z5/hall/roof-timbers": {
        "reason": "the hall's trusses and the open bays between them -- roof structure read from the floor below, never floor"
      },
      "z7/approach/ruin-tops": {
        "reason": "the broken wall-heads of the collapsed buildings the ramp climbs between"
      },
      "z7/approach/ruin-walls": {
        "reason": "the rubble of those walls, and the gaps its own collapse left in it"
      },
      "z7/ward/low-walls": {
        "reason": "the low ruined walls standing in the ward, and the gaps in their rubble"
      },
      "z7/ward/wall-tops": {
        "reason": "the air over the ward, walked on only where a ruined wall-head stands in it"
      },
      "z7/tower/slit": {
        "reason": "the window slits cut through the tower wall"
      },
      "z7/tower/bell": {
        "reason": "the bell itself, and the ledges of its own casting"
      }
    },

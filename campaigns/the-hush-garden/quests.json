    "quests": [
      {
        "cast": {
          "npc/wren": {
            "at": "anchor/gardener",
            "dialogue": {
              "barks": [
                "Wren is too far off to hear, beyond the great gate."
              ]
            },
            "doing": "Out in the meadow beyond the great gate, still tidying up after closing, not knowing anyone is inside."
          }
        },
        "happening": {
          "text": "The two friends find out they are locked in, and how to get out.",
          "verb": "learns"
        },
        "id": "quest/locked-in",
        "objectives": [
          {
            "anchor": "anchor/note-basket",
            "count": 1,
            "happening": {
              "text": "The note says the gate is wound shut, where the crank is, and what sleeps under the well.",
              "verb": "learns"
            },
            "hint": "In the barrel beside the bench, at the foot of the watchtower.",
            "holder": "anchor/note-basket",
            "id": "obj/take-the-note",
            "item": "minecraft:paper",
            "item_name": "Wren's Note",
            "title": "Take the note from the barrel",
            "type": "collect"
          }
        ],
        "on_complete": [
          {
            "happening": {
              "subject": "wave/rose-slimes",
              "text": "Slimes bounce in the rose lanes.",
              "verb": "arrives"
            },
            "type": "spawn-wave",
            "wave": "wave/rose-slimes"
          },
          {
            "happening": {
              "subject": "wave/yellow-slimes",
              "text": "Slimes bounce in the yellow lanes.",
              "verb": "arrives"
            },
            "type": "spawn-wave",
            "wave": "wave/yellow-slimes"
          }
        ],
        "on_objective_complete": {
          "obj/take-the-note": [
            {
              "text": "\"Closing! Gate wound shut. If you're reading this you're locked in, and I'm so sorry.\"",
              "type": "narrate"
            },
            {
              "text": "\"The crank handle hangs on the sundial in the rose quarter. Fit it to the winch in the gate tower, the tall pale one at the far edge of the maze, and wind.\"",
              "type": "narrate"
            },
            {
              "text": "\"And walk softly. Something old sleeps under the well in the green quarter, and it wakes to footsteps. If it's up, crouch. A bell will turn its head. — Wren\"",
              "type": "narrate"
            }
          ]
        },
        "trigger": {
          "type": "campaign-start"
        }
      },
      {
        "cast": {
          "npc/wren": {
            "at": "anchor/gardener",
            "dialogue": {
              "barks": [
                "Wren is too far off to hear, beyond the great gate."
              ]
            },
            "doing": "Still in the meadow, humming, coiling a hose."
          }
        },
        "happening": {
          "text": "The runner fetches the crank handle, and the sleeper under the well wakes.",
          "verb": "gains"
        },
        "id": "quest/the-crank",
        "objectives": [
          {
            "anchor": "anchor/sundial",
            "happening": {
              "text": "The runner finds the sundial court.",
              "verb": "arrives"

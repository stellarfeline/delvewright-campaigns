{
  "campaign_id": "the-hush-garden",
  "content": {
    "dialogues": [
      {
        "nodes": [
          {
            "id": "dlg/wren-together",
            "options": [
              {
                "label": "What was that thing?",
                "next": "dlg/wren-thing"
              },
              {
                "effects": [
                  {
                    "objective": "obj/meet-wren",
                    "type": "complete-objective"
                  }
                ],
                "label": "We made it."
              }
            ],
            "text": "Oh! Oh, you're out, both of you! I wound that gate with you inside, didn't I. And you came over the bridge? Nobody's walked that bridge in thirty summers. I'm so sorry. I was frightened just watching you come over it."
          },
          {
            "id": "dlg/wren-thing",
            "options": [
              {
                "effects": [
                  {
                    "objective": "obj/meet-wren",
                    "type": "complete-objective"
                  }
                ],
                "label": "We made it."
              }
            ],
            "text": "The Listener. It sleeps under the old well and hears every footstep in the maze. We gardeners walk softly and wind the gate at dusk, and it sleeps. Tonight it didn't. Tomorrow I'm hanging a bell at the gate as well."
          },
          {
            "id": "dlg/wren-alone",
            "options": [
              {
                "label": "What was that thing?",
                "next": "dlg/wren-thing-alone"
              },
              {
                "label": "I'll wait for them."
              },
              {
                "effects": [
                  {
                    "objective": "obj/meet-wren",
                    "type": "complete-objective"
                  }
                ],
                "label": "Just me tonight."
              }
            ],
            "text": "Oh! You're out! I wound that gate with you inside, didn't I. I'm so sorry. Is there anyone else in there? If someone's up the watchtower, the bridge is up now: they can walk over the top of the maze, if they've the nerve."
          },
          {
            "id": "dlg/wren-thing-alone",
            "options": [
              {
                "label": "I'll wait for them."
              },
              {
                "effects": [
                  {
                    "objective": "obj/meet-wren",
                    "type": "complete-objective"
                  }
                ],
                "label": "Just me tonight."
              }
            ],
            "text": "The Listener. It sleeps under the old well and hears every footstep in the maze. We gardeners walk softly and wind the gate at dusk, and it sleeps. Tonight it didn't."
          }
        ],
        "npc": "npc/wren",

.DS_Store
out/
out-*/
*.log
campaigns/*/out2/

# A working-tree convenience symlink some tooling creates; it points at an
# absolute path on one machine and is dangling everywhere else.
campaigns/campaigns

# Python build output. It is not authored, and a  after running
# the tool suite is all it takes for it to reach a commit — which is how three
# .pyc files landed on main.
__pycache__/
*.py[cod]

# What the authoring toolchain leaves in this checkout
# (`.claude/skills/new-delve/SKILL.md`, Init). `out/` above is a build tree; these
# are the creator's own machine's working paths, and every one of them is created
# by a command the skill prints. Left unignored, the first `git add -A` after a
# run commits a virtualenv, a launcher jar and a directory of draft images.
.out/
.venv-skin/
.refimg/
ChunkyLauncher.jar

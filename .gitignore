.DS_Store
out/
out-*/
*.log
campaigns/*/out2/

# A working-tree convenience symlink some tooling creates; it points at an
# absolute path on one machine and is dangling everywhere else.
campaigns/campaigns

# A generator writes a judgement report beside the prefab it expands. It is not
# prefab metadata, and the loader parses every .json under prefabs/ as metadata,
# so committing one is DW0346 on every build. Keep it out of the tree rather than
# out of somebody remembering.
prefabs/*.report.json
